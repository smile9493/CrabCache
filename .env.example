# Copy to .env and fill in before: docker compose up -d
#
# Quick start (new-api style):
#   cp .env.example .env
#   # set CRABCACHE_API_KEY and CRABCACHE_GATEWAY_ADMIN_KEY
#   docker compose up -d

# Upstream DeepSeek API key(s). Comma-separated quota pool (recommended for Cursor / production).
# When set, overrides single-key CRABCACHE_API_KEY for outbound DeepSeek calls only.
# CRABCACHE_UPSTREAM_KEYS=sk-ds-1,sk-ds-2,sk-ds-3
CRABCACHE_API_KEY=

# Cursor: use sk-cc-* from Management POST /v1/keys — never put upstream sk-ds-* in Cursor settings.

# Client Bearer keys to register on startup (comma-separated; survives container restart).
# CRABCACHE_BOOTSTRAP_CLIENT_KEYS=sk-cc-...,sk-your-client-key

# Upstream relay origin (OpenAI-compatible API root, no trailing /v1).
# CRABCACHE_UPSTREAM_BASE_URL=https://api.deepseek.com
# CRABCACHE_UPSTREAM_MODEL=deepseek-v4-pro

# Management API admin secret (x-gateway-admin-key). Change in production.
CRABCACHE_GATEWAY_ADMIN_KEY=change-me-in-production

# Admin dashboard (docker compose --profile admin)
# CRABCACHE_ADMIN_KEY=change-me-in-production
# CRABCACHE_ADMIN_STATE_PATH=data/admin-state.json
# CRABCACHE_MODEL_SYNC_INTERVAL_SECS=3600
#
# Infra monitoring (container/host resource monitoring):
# Mount /var/run/docker.sock into admin container (read-only) and set the
# Compose project name (defaults to "crabcache") to filter containers.
# CRABCACHE_COMPOSE_PROJECT=crabcache
# CRABCACHE_DOCKER_HOST=unix:///var/run/docker.sock
# CRABCACHE_DOCKER_ALLOW_TCP=0
# CRABCACHE_INFRA_CACHE_TTL_SECS=5
# CRABCACHE_INFRA_COLLECT_INTERVAL_SECS=5
# CRABCACHE_INFRA_SAMPLE_INTERVAL_SECS=60
# CRABCACHE_SPEED_TEST_JOB_TTL_SECS=900
# CRABCACHE_SPEED_TEST_MAX_UPLOAD_BYTES=67108864
# CRABCACHE_SPEED_TEST_MAX_UPLOAD_ATTEMPTS=5
#
# Keys page: client-facing gateway URLs shown in the dashboard
# CRABCACHE_GATEWAY_CLIENT_PORT=8080
# Docker: set LAN host to the host machine IP reachable from your LAN (not the container IP)
# CRABCACHE_GATEWAY_CLIENT_LAN_HOST=192.168.1.100
# OpenResty / reverse-proxy client base URL (origin, no /v1; auto-detected from 1Panel conf when mounted):
# CRABCACHE_GATEWAY_OPENRESTY_BASE_URL=https://v4.example.com:18000
# CRABCACHE_OPENRESTY_CONF_DIR=/host/openresty/conf.d
# Legacy alias: CRABCACHE_GATEWAY_CLIENT_BASE_URL=https://v4.example.com:18000

# Multi-instance / production: shared control plane + reasoning in Redis (see docs/PERSISTENCE.md)
CRABCACHE_STATE_BACKEND=redis
CRABCACHE_REASONING_BACKEND=redis

# Optional Redis AUTH (uncomment and set requirepass in redis service / redis.conf)
# CRABCACHE_L1_REDIS_URL=redis://:your-password@redis:6379
# CRABCACHE_STATE_REDIS_URL=redis://:your-password@redis:6379
# CRABCACHE_REASONING_REDIS_URL=redis://:your-password@redis:6379

# Optional overrides
# CRABCACHE_L1_REDIS_URL=redis://redis:6379
# CRABCACHE_MANAGEMENT_LISTEN=0.0.0.0:9080

# For scripts/verify_deployment.sh — sk-cc-* from Management (auto-created if MGMT_KEY set)
# CLIENT_API_KEY=sk-cc-...

# Optional: enable legacy mode in verify script when migrating old clients
# ALLOW_LEGACY_CLIENT_KEY=1

# Optional: scrape Prometheus during verify
# VERIFY_METRICS=1
