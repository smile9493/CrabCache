# Copy to .env and fill in before: docker compose up -d
#
# Quick start (new-api style):
#   cp .env.example .env
#   # set CRABCACHE_API_KEY and CRABCACHE_GATEWAY_ADMIN_KEY
#   docker compose up -d

# Upstream DeepSeek API key(s). Comma-separated for quota pool; CRABCACHE_API_KEY still works as a single-key alias.
# CRABCACHE_UPSTREAM_KEYS=sk-ds-1,sk-ds-2,sk-ds-3
CRABCACHE_API_KEY=

# Client Bearer keys to register on startup (comma-separated; survives container restart).
# CRABCACHE_BOOTSTRAP_CLIENT_KEYS=sk-cc-...,sk-your-client-key

# Upstream relay origin (OpenAI-compatible API root, no trailing /v1).
# CRABCACHE_UPSTREAM_BASE_URL=https://api.deepseek.com
# CRABCACHE_UPSTREAM_MODEL=deepseek-v4-pro

# Management API admin secret (x-gateway-admin-key). Change in production.
CRABCACHE_GATEWAY_ADMIN_KEY=change-me-in-production

# Admin dashboard (docker compose --profile admin)
# CRABCACHE_ADMIN_KEY=change-me-in-production
# CRABCACHE_ADMIN_STATE_PATH=data/admin-state.json
# CRABCACHE_MODEL_SYNC_INTERVAL_SECS=3600

# Optional overrides
# CRABCACHE_L1_REDIS_URL=redis://redis:6379
# CRABCACHE_MANAGEMENT_LISTEN=0.0.0.0:9080

# For scripts/verify_deployment.sh — sk-cc-* from Management (auto-created if MGMT_KEY set)
# CLIENT_API_KEY=sk-cc-...

# Optional: enable legacy mode in verify script when migrating old clients
# ALLOW_LEGACY_CLIENT_KEY=1

# Optional: scrape Prometheus during verify
# VERIFY_METRICS=1
