# =============================================================================
# CrabCache .gitignore
# Keep Rust toolchains and Cargo caches OUT of the repo tree (use ~/.rustup,
# ~/.cargo). Local installs under the project cause 10k+ untracked files.
# =============================================================================

# --- Rust / Cargo (build & toolchains) ---
/target/
/target_docker/
**/*.rs.bk
.rustup/
.cargo/
.cargo_home/

# --- Frontend / WASM ---
node_modules/
crates/crab-dashboard/dist/
dist/
build/
pkg/

# --- IDE / editor (not project source) ---
.idea/
.vscode/
.cursor/
*.swp
*.swo
.trae/

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets & local config ---
.git-credentials
config/gateway.toml
.env
.env.*
!.env.example

# --- Runtime data & logs ---
data/
*.log
*.sqlite3
docker/data/
gateway_logs/

# --- Large model artifacts ---
models/*.onnx

# --- TLS (local dev certs) ---
certs/

# --- Test / Python artifacts ---
tests/*.png
tests/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- Coverage & profiling ---
coverage/
*.profraw
*.profdata
tarpaulin-report.html
lcov.info

# --- Misc local scratch ---
site/
.cache/
doc_content.txt
read_doc.ps1
tests/*.md
.git-credentials
