# Nginx reverse proxy for CrabCache Agent API (OpenAI-compatible).
# Install: copy to /etc/nginx/sites-available/ and symlink sites-enabled.
# Replace api.example.com with your domain and configure TLS (certbot, etc.).
#
# Do NOT proxy port 9080 (Management API) to the public internet.

upstream crabcache_gateway {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name api.example.com;

    # Redirect HTTP to HTTPS in production:
    # return 301 https://$host$request_uri;

    client_max_body_size 4m;

    location / {
        proxy_pass http://crabcache_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # SSE / streaming chat completions
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

