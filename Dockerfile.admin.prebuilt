FROM ubuntu:latest

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY .cargo-target/release/crab-admin /app/crab-admin
COPY crates/crab-dashboard/dist ./crates/crab-dashboard/dist

ENV CRABCACHE_GATEWAY_CONTROL_URL=http://gateway:9080
ENV CRABCACHE_ADMIN_KEY=admin

EXPOSE 3000

CMD ["/app/crab-admin", "--listen", "0.0.0.0:3000"]