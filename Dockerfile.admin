FROM rust:1.88-slim AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    curl \
    cmake \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/local/cargo && \
    printf '[source.crates-io]\nreplace-with = "tuna"\n[source.tuna]\nregistry = "https://mirrors.tuna.tsinghua.edu.cn/git/crates.io-index.git"' \
    > /usr/local/cargo/config.toml

RUN rustup target add wasm32-unknown-unknown
RUN curl -fsSL https://github.com/trunk-rs/trunk/releases/download/v0.21.8/trunk-x86_64-unknown-linux-gnu.tar.gz \
    | tar xzf - -C /usr/local/cargo/bin && \
    chmod +x /usr/local/cargo/bin/trunk

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY third_party/pingora-proxy third_party/pingora-proxy
COPY crates crates

RUN cargo build --release -p crab-admin

WORKDIR /app/crates/crab-dashboard
RUN trunk build --release

FROM ubuntu:latest

RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/crab-admin /app/crab-admin
COPY --from=builder /app/crates/crab-dashboard/dist ./crates/crab-dashboard/dist

ENV CRABCACHE_GATEWAY_CONTROL_URL=http://gateway:9080
ENV CRABCACHE_ADMIN_KEY=admin

EXPOSE 3000

CMD ["/app/crab-admin", "--listen", "0.0.0.0:3000"]