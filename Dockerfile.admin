FROM rust:1.95-slim AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    curl \
    cmake \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/local/cargo && \
    printf '[source.crates-io]\nreplace-with = "tuna"\n[source.tuna]\nregistry = "https://mirrors.tuna.tsinghua.edu.cn/git/crates.io-index.git"' \
    > /usr/local/cargo/config.toml

RUN rustup target add wasm32-unknown-unknown
ARG TRUNK_VERSION=0.21.14
RUN curl -fsSL https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/trunk-x86_64-unknown-linux-gnu.tar.gz \
    | tar xzf - -C /usr/local/cargo/bin && \
    chmod +x /usr/local/cargo/bin/trunk

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY third_party/pingora-proxy third_party/pingora-proxy
COPY crates crates

# Build admin backend with BuildKit cache mount
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release -p crab-admin \
    && cp /app/target/release/crab-admin /app/crab-admin

WORKDIR /app/crates/crab-dashboard
ENV TRUNK_LOG=trace
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/root/.cache/trunk \
    trunk build --release -v

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

RUN groupadd -r crabcache && useradd -r -g crabcache -s /bin/false crabcache

WORKDIR /app

RUN mkdir -p /app/data /app/logs

COPY --from=builder /app/crab-admin /app/crab-admin
COPY --from=builder /app/crates/crab-dashboard/dist ./crates/crab-dashboard/dist

RUN chown -R crabcache:crabcache /app

ENV CRABCACHE_GATEWAY_CONTROL_URL=http://gateway:9080
# CRABCACHE_ADMIN_KEY must be set via environment or docker-compose; no hardcoded default.

EXPOSE 3000

USER crabcache

CMD ["/app/crab-admin", "--listen", "0.0.0.0:3000"]
