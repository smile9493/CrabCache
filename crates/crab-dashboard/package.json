{
  "name": "crab-dashboard",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i style/input.css -o style/output.css --minify",
    "watch:css": "npx @tailwindcss/cli -i style/input.css -o style/output.css --watch",
    "build": "npm run build:css && trunk build --release",
    "dev": "npm run build:css && trunk serve"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}